# Copy to .env and fill in only the keys you use. Never commit .env.
FOOTBALL_DATA_TOKEN=
API_FOOTBALL_KEY=
THE_ODDS_API_KEY=
EXPO_PUBLIC_PICKS_URL=
ODDS_REGION=uk
ODDS_MIN_CREDITS_REMAINING=10

# Historical CSV downloads remain disabled unless deliberately enabled.
ALLOW_FOOTBALL_DATA_DOWNLOADS=false
MIN_HISTORY_SEASONS_PER_LEAGUE=5

# Optional API-Football goal-minute backfill (runs after the daily job).
TIMING_BACKFILL_ENABLED=false
TIMING_BACKFILL_LEAGUE=E0
# Latest season verified accessible on the current free key as of 2026-10-23.
TIMING_BACKFILL_START_SEASON=2024
TIMING_BACKFILL_MIN_SEASON=2022
TIMING_BACKFILL_RESERVE=40
TIMING_BACKFILL_MAX_REQUESTS_PER_RUN=30
TIMING_MIN_GOALS_PER_LEAGUE=3000
TIMING_MIN_TEAM_GOALS=120
