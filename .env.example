# Required for the daily real-data job (store actual values in ignored .env/CI secrets).
FOOTBALL_DATA_TOKEN=

# Optional market reference feed; predictions continue without odds when unset.
THE_ODDS_API_KEY=
ODDS_REGION=uk
ODDS_MIN_CREDITS_REMAINING=10

# Football-Data.co.uk explicitly limits automation and says free downloads are not
# intended for data-training projects. Keep false unless permission/license allows it.
ALLOW_FOOTBALL_DATA_DOWNLOADS=false

# Public static URL consumed by Expo. Set as Expo public environment at build time.
EXPO_PUBLIC_PICKS_URL=
